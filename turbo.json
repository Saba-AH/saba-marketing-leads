{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      // En `envMode: strict` lo que no está acá no llega a la tarea. API_URL es
      // la de NestJS para el BFF del cliente; DATABASE, por si se exporta en el
      // shell en vez de ponerla en apps/api/.env.
      "passThroughEnv": ["API_URL", "DATABASE"],
      "cache": false,
      "persistent": true
    },
    // Resumen de contra qué corre la API y qué abrir (`apps/api/scripts/devInfo.ts`):
    // aparece en el sidebar de la TUI junto a las tareas `dev`. Con
    // NODE_ENV=development además mantiene abierto el túnel de Cloudflare del
    // webhook de WhatsApp, por eso es persistente.
    "dev:info": {
      "passThroughEnv": ["DATABASE"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      // Turbo corre en `envMode: strict`: lo que no está acá no llega a la
      // tarea. Los tests de la API se conectan a Postgres de verdad, así que
      // sin esto vitest cae a su default (`localhost:5434`) — que acierta en
      // el runner de GitHub y falla dentro de un contenedor de build, donde la
      // base es un sidecar en otro host.
      "env": ["DATABASE"],
      "outputs": []
    },
    "py:setup": {
      "cache": false
    },
    "py:dev": {
      "cache": false,
      "persistent": true
    },
    "py:lint": {
      "dependsOn": [],
      "outputs": []
    },
    "py:format": {
      "cache": false
    },
    "py:test": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
