# Dependencias y builds
node_modules/
dist/
dist-ssr/
build/
.next/
coverage/

# El export estático de Next. Anclado a la app y NO como `out/` suelto: esa
# forma ignora cualquier carpeta llamada `out` a cualquier profundidad, y la
# arquitectura hexagonal de apps/api tiene un `application/ports/out/` por
# módulo. Con la regla suelta, esos puertos quedan sin trackear y un clon
# limpio no compila.
apps/client/out/
*.tsbuildinfo

# Turborepo
.turbo/

# Pulumi (infra/): artefactos de compile, no el programa
infra/bin/
infra/node_modules/

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.pem
credentials.json

# Credenciales de servicio (GCP service accounts, llaves) — NUNCA commitear
**/secrets/
*-sa.json
*.key.json
*credecial*
*credencial*
# …pero el código fuente no es una credencial (CredencialesInvalidasException.ts).
!*credencial*.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Editores e IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Temporales
*.tmp
*.temp
.cache/

# Python (por si un servicio o script del repo lo usa)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Ajustes locales de Claude Code (por desarrollador)
.claude/settings.local.json

# Logos guardados por el adaptador local de storage (desarrollo, #92)
.local-storage/
