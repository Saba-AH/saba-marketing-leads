# =============================================================================
# Raíz del monorepo — SOLO el Postgres local de docker-compose
#
# Copiar a `.env` (gitignored) solo si hace falta cambiar algo; sin archivo,
# docker-compose usa estos mismos valores por defecto.
#
# Esto NO es Supabase. Acá van el usuario, la contraseña, el NOMBRE de la base
# dentro del contenedor y el puerto del host. La conexión a Supabase y el
# selector local/supabase (`DB_TARGET`) viven en `apps/api/.env`.
#
# La configuración de cada app vive en su propio .env:
#   - apps/api/.env      (copiar de apps/api/.env.example)
#   - apps/client/.env   (copiar de apps/client/.env.example)
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Nombre de la base que se crea en el contenedor (no un host).
POSTGRES_DB=app_dev

# Puerto del HOST. 5433 a propósito: un Postgres instalado en la máquina suele
# ocupar el 5432 (ver docker-compose.yml). Si lo cambiás, también en
# `DATABASE_LOCAL` de apps/api/.env y en `.github/workflows/ci.yml`.
POSTGRES_PORT=5433

# Si cambiás cualquiera de los de arriba, `DATABASE_LOCAL` de apps/api/.env
# tiene que quedar así:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
# Ojo: el usuario/contraseña solo se aplican al CREAR el volumen. Para que tomen
# efecto sobre uno existente: `npm run db:reset` (borra los datos locales).
