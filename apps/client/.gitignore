# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# El ejemplo sí se versiona: es la única documentación de qué variables
# existen. Sin esta excepción —que el .gitignore de la raíz sí tiene— el
# archivo no se podía commitear y esta app quedó sin ninguna.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
