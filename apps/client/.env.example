# =============================================================================
# apps/client — variables de entorno
#
# Copiar a `apps/client/.env.local` (gitignored) solo si hace falta cambiar
# algo: los valores por defecto ya sirven para desarrollo local.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime (servidor de Next): se leen al arrancar, no se hornean en el build
# -----------------------------------------------------------------------------
# API de NestJS vista desde el servidor de Next (BFF). El navegador nunca la
# llama directo: pasa por `/api/session/*` y el proxy `/api/backend/*`, que
# agregan el token desde la cookie `httpOnly`. Por defecto: http://localhost:8080
API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Build time y públicas: Next las inlinea en el bundle (`apps/client/Dockerfile`)
# -----------------------------------------------------------------------------
# Site key de Cloudflare Turnstile del login. Vacía → la de prueba que siempre
# valida (va con la secret de prueba en apps/api/.env). En producción, la del
# sitio real, con el dominio del panel agregado en Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
