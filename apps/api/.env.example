# apps/api — copiar a `apps/api/.env`

PORT=8080
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3002
APP_VERSION=0.0.0-dev

# El destino lo elige el comando: `npm run dev:local` o `npm run dev:supabase`.

# Local (`npm run dev:local`): nada que completar, lo inyecta el comando y le
# gana a este archivo, así que el bloque de Supabase puede quedar completo.

# Supabase (`npm run dev:supabase`: datos reales; no migra, eso es
# `npm run db:migrate:supabase`)
DATABASE_SUPABASE=            # Dashboard → Connect (puerto 5432)
SUPABASE_URL=                 # https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_… o anon. Nunca la de servicio
SUPABASE_JWT_SECRET=          # solo si JWT Keys sigue en "Legacy HS256"

# Comunes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # prueba de Cloudflare
TRUST_PROXY_HOPS=1            # proxies entre el BFF y la API (rate limit por IP)

# WhatsApp Cloud API (`.scratch/whatsapp-chats/PLAN.md`). Opcional: sin estas
# variables la API arranca igual y el webhook rechaza todo.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=        # usuario del sistema saba-chat-api, caducidad "Nunca"
WHATSAPP_APP_SECRET=          # Saba-Chat → Configuración de la app → Básica: firma del webhook
WHATSAPP_VERIFY_TOKEN=        # lo inventas (openssl rand -hex 32); el mismo va en Meta → Webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
